{
  "listeners": [
    {
      "address": "0.0.0.0",
      "port": 8080,
      "https": false
    }
  ],
  "db_clients": [
    {
      "name": "default",
      "rdbms": "postgresql",
      "host": "127.0.0.1",
      "port": 5432,
      "dbname": "ticketing",
      "user": "ticketing",
      "passwd": "ticketing_dev",
      "is_fast": false,
      "number_of_connections": 4,
      "timeout": 5.0,
      "client_encoding": "UTF8"
    }
  ],
  "redis_clients": [
    {
      "name": "traffic_control",
      "host": "localhost",
      "port": 6379,
      "is_fast": false,
      "number_of_connections": 2,
      "timeout": 0.4
    },
    {
      "name": "seat_holds",
      "host": "127.0.0.1",
      "port": 6379,
      "is_fast": false,
      "number_of_connections": 2,
      "timeout": 0.4
    },
    {
      "name": "auth_sessions",
      "host": "127.0.0.1",
      "port": 6379,
      "is_fast": false,
      "number_of_connections": 2,
      "timeout": 0.4
    }
  ],
  "app": {
    "number_of_threads": 0,
    "enable_session": false,
    "document_root": "./public",
    "upload_path": "uploads",
    "client_max_body_size": "1M",
    "client_max_memory_body_size": "64K"
  },
  "custom_config": {
    "traffic_control": {
      "bulkheads": {
            "PUBLIC_STATIC_READ": 16,
            "ADMISSION": 16,
            "AVAILABILITY": 16,
            "INVENTORY_WRITE": 16,
            "RECOVERY": 16,
            "FINANCIAL": 16,
            "ADMIN": 16,
            "POSTGRES_FALLBACK": 2
      },
      "account_capacity": 20,
      "account_rate": 10,
      "event_capacity": 200,
      "event_rate": 100
},
    "admission": {
      "policy_refresh_ms": 2000,
      "policy_limit": 10000,
      "scheduler_batch": 64,
      "scheduler_ms": 250,
      "poll_ms": 2000,
      "heartbeat_ms": 5000,
      "presence_seconds": 30
    },
    "admin_catalog": {
      "max_zones_per_venue": 32,
      "max_rows_per_zone": 200,
      "max_seats_per_row": 500,
      "max_seats_per_venue": 20000,
      "max_sessions_per_event": 20
    },
    "seat_availability_read_model": {
      "init_lock_seconds": 15,
      "init_wait_milliseconds": 1000,
      "stream_maxlen": 10000,
      "delta_scan_limit": 1000,
      "expiry_cleanup_batch": 512,
      "checkout_owner_cache_ttl_seconds": 600
    },
    "seat_availability_projection": {
      "batch_size": 100,
      "interval_seconds": 0.5,
      "lease_seconds": 5
    },
    "seat_map_compute_workers": 4,
    "seat_map_compute_queue_capacity": 16,
    "order_expiry_worker": {
      "batch_size": 100,
      "interval_seconds": 5.0
    },
    "checkout_session_reconciliation": {
      "batch_size": 100
    },
    "checkout_seat_hold": {
      "ttl_seconds": 300
    },
    "payment_simulation": {
      "min_delay_seconds": 2.0,
      "max_delay_seconds": 6.0,
      "failure_rate": 0.01,
      "processing_grace_seconds": 10.0
    },
    "payment_reconciliation": {
      "batch_size": 100,
      "interval_seconds": 2.0,
      "max_backoff_seconds": 60.0
    },
    "authentication": {
      "idle_timeout_seconds": 86400,
      "absolute_timeout_seconds": 604800,
      "session_cache_ttl_seconds": 300,
      "last_seen_write_interval_seconds": 300,
      "cookie_name": "ticketing_session",
      "csrf_cookie_name": "ticketing_csrf",
      "cookie_secure": false,
      "allowed_origins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173"
      ],
      "password_hash_workers": 4,
      "password_hash_queue_capacity": 64,
      "argon2_time_cost": 2,
      "argon2_memory_cost_kib": 65536,
      "argon2_parallelism": 1
    },
    "login_rate_limit": {
      "window_seconds": 60,
      "max_failures": 5
    }
  }
}
