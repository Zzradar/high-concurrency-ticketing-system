      "targets": [{"expr": "ticketing_http_requests_in_flight", "legendFormat": "in flight", "refId": "A"}],
      "title": "Backend in-flight requests",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "ticketing-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 7, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "targets": [
        {"expr": "sum(rate(ticketing_http_requests_total{status_class=\"4xx\"}[1m]))", "legendFormat": "4xx/s", "refId": "A"},
        {"expr": "sum(rate(ticketing_http_requests_total{status_class=\"5xx\"}[1m]))", "legendFormat": "5xx/s", "refId": "B"}
      ],
      "title": "Backend error rates",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "ticketing-prometheus"},
