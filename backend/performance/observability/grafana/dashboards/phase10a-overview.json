{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "ticketing-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 7, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum(rate(ticketing_http_requests_total[1m]))", "legendFormat": "requests/s", "refId": "A"}],
      "title": "Backend request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "ticketing-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 7, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(ticketing_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(ticketing_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(ticketing_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "C"}
      ],
      "title": "Backend latency percentiles",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "ticketing-prometheus"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 7, "w": 6, "x": 12, "y": 0},
