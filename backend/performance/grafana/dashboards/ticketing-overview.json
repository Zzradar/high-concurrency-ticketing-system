      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "id": 5,
      "targets": [{"expr": "rate(pg_stat_statements_calls{datname=\"ticketing\"}[5m])", "legendFormat": "statements/s", "refId": "A"}],
      "title": "PostgreSQL statement rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "ticketing-prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
