  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "ticketing-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "targets": [{"expr": "sum(rate(ticketing_http_requests_total[1m]))", "legendFormat": "requests/s", "refId": "A"}],
      "title": "Backend request rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "ticketing-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(ticketing_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A"}],
      "title": "Backend p95 latency",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "ticketing-prometheus"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "targets": [{"expr": "ticketing_http_requests_in_flight", "legendFormat": "in flight", "refId": "A"}],
      "title": "Backend in-flight requests",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "ticketing-prometheus"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "id": 4,
